STARSMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New...\tCtrl+N", IDM_TOOL_NEW_GAME
        MENUITEM "Custom &Race Wizard...", IDM_RACE_CREATE
        MENUITEM "&Open...\tCtrl+O", IDM_TOOL_OPEN_GAME
        MENUITEM "&Close", IDM_FILE_RETURN_TO_TITLE
        MENUITEM "&Save\tCtrl+S", IDM_TURN_END_A
        MENUITEM "Save &And Submit\tCtrl+A", IDM_TURN_END_B
        MENUITEM SEPARATOR
        MENUITEM "&Print Map", IDM_FILE_PRINT_MAP
        MENUITEM SEPARATOR
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar", IDM_VIEW_TOOLBAR
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F", IDM_VIEW_FIND
        POPUP "&Zoom"
        BEGIN
            MENUITEM "25%", IDM_SCAN_ZOOM_0
            MENUITEM "38%", IDM_SCAN_ZOOM_1
            MENUITEM "50%", IDM_SCAN_ZOOM_2
            MENUITEM "75%", IDM_SCAN_ZOOM_3
            MENUITEM "100%", IDM_SCAN_ZOOM_4
            MENUITEM "125%", IDM_SCAN_ZOOM_5
            MENUITEM "150%", IDM_SCAN_ZOOM_6
            MENUITEM "200%", IDM_SCAN_ZOOM_7
            MENUITEM "400%", IDM_SCAN_ZOOM_8
        END
        POPUP "&Window Layout"
        BEGIN
            MENUITEM "&Large Screen", IDM_VIEW_LAYOUT_0
            MENUITEM "&Medium Screen", IDM_VIEW_LAYOUT_1
            MENUITEM "&Small Screen", IDM_VIEW_LAYOUT_2
        END
        MENUITEM "Player &Colors", IDM_VIEW_PLAYER_COLORS
        MENUITEM SEPARATOR
        MENUITEM "&Race...\tF8", IDM_RACE_EDIT1
        MENUITEM "&Game Parameters...", IDM_VIEW_GAME_PARAMS
    END
    POPUP "&Turn"
    BEGIN
        MENUITEM "&Wait for New", IDM_TURN_WAIT_NEW, GRAYED
        MENUITEM "&Generate\tF9", IDM_FILE_HOST_GAME, GRAYED
    END
    POPUP "&Commands"
    BEGIN
        MENUITEM "&Ship Design...\tF4", IDM_GAME_SHIP_BUILDER
        MENUITEM "&Research...\tF5", IDM_GAME_RESEARCH
        MENUITEM "&Battle Plans...\tF6", IDM_GAME_BATTLE_PLANS2
        MENUITEM "&Player Relations...\tF7", IDM_GAME_RELATIONS2
        MENUITEM SEPARATOR
        MENUITEM "&Change Password...", IDM_CMD_CHANGE_PASSWORD
    END
    POPUP "&Report"
    BEGIN
        MENUITEM "&Planets...\tF3", IDM_REPORT_PLANET
        MENUITEM "&Fleets...\tF3", IDM_REPORT_FLEET
        MENUITEM "&Others' Fleets...\tF3", IDM_REPORT_ENEMY_FLEET
        MENUITEM SEPARATOR
        MENUITEM "&Battles...\tF3", IDM_REPORT_BATTLE
        MENUITEM SEPARATOR
        MENUITEM "&Score...\tF10", IDM_GAME_SCORE
        MENUITEM SEPARATOR
        POPUP "&Dump to Text File"
        BEGIN
            MENUITEM "&Universe Definition", IDM_DEBUG_DUMP_UNIVERSE
            MENUITEM "&Planet Information", IDM_DEBUG_DUMP_PLANETS
            MENUITEM "&Fleet Information", IDM_DEBUG_DUMP_FLEETS
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Introduction", IDM_HELP_INTRO
        MENUITEM "&Player's Guide\tF1", IDM_HELP_CONTENTS2
        MENUITEM SEPARATOR
        MENUITEM "Technology &Browser\tF2", IDM_VIEW_BROWSER_TOGGLE2
        MENUITEM "&Tutorial", IDM_HELP_TUTORIAL
        MENUITEM SEPARATOR
        MENUITEM "&About Stars!...", IDM_HELP_ABOUT
    END
END

IDA_MAIN ACCELERATORS
BEGIN
    "A", IDM_TURN_SAVE_SUBMIT, VIRTKEY, NOINVERT, CONTROL
    "N", IDM_FILE_NEW_GAME, VIRTKEY, NOINVERT, CONTROL
    "O", IDM_FILE_OPEN_GAME, VIRTKEY, NOINVERT, CONTROL
    "S", WMX_UNKNOWN_006F, VIRTKEY, NOINVERT, CONTROL
    "F", IDM_UNKNOWN_1069, VIRTKEY, NOINVERT, CONTROL
    VK_F1, IDM_HELP_CONTENTS, VIRTKEY, NOINVERT
    VK_F2, IDM_VIEW_BROWSER_TOGGLE, VIRTKEY, NOINVERT
    VK_F3, IDM_REPORT_CYCLE, VIRTKEY, NOINVERT
    VK_F4, IDM_GAME_SHIP_BUILDER2, VIRTKEY, NOINVERT
    VK_F5, IDM_GAME_RESEARCH2, VIRTKEY, NOINVERT
    VK_F6, IDM_GAME_BATTLE_PLANS1, VIRTKEY, NOINVERT
    VK_F7, IDM_GAME_RELATIONS, VIRTKEY, NOINVERT
    VK_F8, IDM_RACE_EDIT2, VIRTKEY, NOINVERT
    VK_F9, WMX_UNKNOWN_006C, VIRTKEY, NOINVERT
    VK_F10, IDM_GAME_SCORE2, VIRTKEY, NOINVERT
    VK_F12, IDM_DEBUG_GEN_10_TURNS, VIRTKEY, NOINVERT
    VK_F12, IDM_DEBUG_GEN_100_TURNS, VIRTKEY, NOINVERT, CONTROL
    VK_F12, IDM_DEBUG_GEN_1000_TURNS, VIRTKEY, NOINVERT, SHIFT
END

IDA_TITLE ACCELERATORS
BEGIN
    "N", IDM_TITLE_NEW_GAME, VIRTKEY, NOINVERT, ALT
    "O", IDM_TITLE_OPEN_GAME, VIRTKEY, NOINVERT, ALT
    "C", IDM_TITLE_CONTINUE, VIRTKEY, NOINVERT, ALT
    "X", IDM_TITLE_EXIT, VIRTKEY, NOINVERT, ALT
END

IDD_ABOUT DIALOG 17, 15, 192, 175
STYLE WS_CAPTION | WS_SYSMENU | DS_SETFONT | DS_MODALFRAME
CAPTION "About Stars!"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "StarsIco", -1, "Static", WS_CHILD | WS_VISIBLE | WS_GROUP | SS_ICON, 8, 8, 18, 20
    CONTROL "Stars! for Microsoft Windows", -1, "Static", WS_CHILD | WS_VISIBLE | WS_GROUP | SS_CENTER, 36, 8, 156, 8
    CONTROL "The Advanced Interstellar Strategy Game", -1, "Static", WS_CHILD | WS_VISIBLE | WS_GROUP | SS_CENTER, 36, 18, 156, 17
    CONTROL "Demo Version", IDC_ABOUT_DEMO_TEXT, "Static", WS_CHILD | WS_VISIBLE | WS_GROUP | SS_CENTER, 4, 32, 184, 8
    CONTROL "Copyright \251 1995-2000  Jeff Johnson && Jeff McBride", -1, "Static", WS_CHILD | WS_VISIBLE | WS_GROUP | SS_CENTER, 4, 48, 184, 8
    CONTROL "Published by empire Interactive", -1, "Static", WS_CHILD | WS_VISIBLE | WS_GROUP | SS_CENTER, 4, 60, 184, 66
    CONTROL "", IDC_ABOUT_CREDITS_TEXT, "Static", WS_CHILD | WS_VISIBLE | WS_GROUP | SS_CENTER, 4, 70, 184, 66
    CONTROL "http://www.webmap.com/stars!", -1, "Static", WS_CHILD | WS_VISIBLE | WS_GROUP | SS_CENTER, 4, 140, 184, 8
    CONTROL "&Order Info...", IDC_ABOUT_ORDER_INFO, "Button", WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_PUSHBUTTON, 32, 156, 48, 14
    CONTROL "OK", IDOK, "Button", WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_DEFPUSHBUTTON, 112, 156, 48, 14
END

