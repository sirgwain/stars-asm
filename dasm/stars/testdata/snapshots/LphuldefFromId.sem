/*
LphuldefFromId  (parts)
  addr: 0002:512c  len=60
  sig:  HULDEF * LphuldefFromId(int16_t id)
  params:
    int16_t          id             [BP+0x6]

  stats: blocks=0  labels=0
*/
L_512c:
    branch id < 0x20 ? L_5150 : L_513e

L_513e:
    return LphuldefSBFromId((id + 0xffe0))

L_5150:
    return &rghuldef[id]

