/*
AlertSz  (utilgen)
  addr: 0009:2160  len=189
  sig:  int16_t AlertSz(char *sz, int16_t mbType)
  params:
    char *           sz             [BP+0x6]
    int16_t          mbType         [BP+0x8]
  locals:
    char[256]        szT            [BP-0x102]

  stats: blocks=0  labels=0
*/
L_2160:
    branch ini.fValidate != 0x0 ? L_21a3 : L_217c

L_217c:
    branch ini.fLogging == 0x0 ? L_21f7 : L_218f

L_218f:
    branch ini.fGen == 0x0 ? L_21f7 : L_21a3

L_21a3:
    call _wsprintf(szT, "Error: %s", sz) -> callresult(int16_t)
    call OutputSz((ini.fValidate == 0x0 ? 6 : 7), szT) -> callresult(void)
    return IDYES




L_21f7:
    return MessageBox(GetFocus(), sz, "Stars!", mbType)

