/*
FCanKillTok  (battle)
  addr: 001f:391e  len=264
  sig:  int16_t FCanKillTok(TOK *ptok1, TOK *ptok2)
  params:
    TOK *            ptok1          [BP+0x6]
    TOK *            ptok2          [BP+0xa]
  locals:
    int32_t          lp2            [BP-0xa]
    int32_t          lp1            [BP-0x6]

  stats: blocks=0  labels=0
*/
L_391e:
    lp1 = LpshdefFromTok(ptok1)->lPower
    lp2 = LpshdefFromTok(ptok2)->lPower
    branch lp2 <= lp1 ? L_398f : L_3986



L_3986:
    return 0

L_398f:
    branch (lp2 & 0x7ffff000) < (lp1 & 0x7ffff000) ? L_39bd : L_39c6



L_39bd:
    return 1

L_39c6:
    branch (lp2 & 0x7fffff00) != (lp1 & 0x7fffff00) ? L_3a1a : L_39ef


L_39ef:
    branch ptok1->spd < ptok2->spd ? L_3a1a : L_3a14

L_3a14:
    return 1

L_3a1a:
    return 0

