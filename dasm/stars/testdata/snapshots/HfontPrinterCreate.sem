/*
HfontPrinterCreate  (utilgen)
  addr: 0009:6aa6  len=202
  sig:  HFONT HfontPrinterCreate(HDC hdc, int16_t iSize, int16_t *pdyFont)
  params:
    HDC              hdc            [BP+0x6]
    int16_t          iSize          [BP+0x8]
    int16_t *        pdyFont        [BP+0xa]
  locals:
    LOGFONT *        plf            [BP-0x6]
    HFONT            hfontNew       [BP-0x4]
    block 0009:6B28  len=0x33
      HFONT            hfontSav       [BP-0x28]
      TEXTMETRIC       tm             [BP-0x26]

  stats: blocks=1  labels=0
*/
L_6aa6:
    plf = LocalAlloc(0x40, 0x32)
    call memset(plf, 0, 0x32) -> callresult(void *)
    plf->lfHeight = neg(MulDiv(iSize, GetDeviceCaps(hdc, LOGPIXELSY), 72))
    call strcpy(plf->lfFaceName, rgszArial[1]) -> callresult(char *)
    hfontNew = CreateFontIndirect(plf)
    branch pdyFont == 0x0 ? L_6b5b : L_6b1f

L_6b1f:
    branch hfontNew == 0x0 ? L_6b5b : L_6b28

L_6b28:
    hfontSav = SelectObject(hdc, hfontNew)
    call GetTextMetrics(hdc, &tm) -> callresult(int16_t)
    *pdyFont = (tm.tmHeight + tm.tmExternalLeading)
    call SelectObject(hdc, hfontSav) -> callresult(HGDIOBJ)

L_6b5b:
    call LocalFree(plf) -> callresult(HLOCAL)

L_6b6a:
    return hfontNew
