/*
FIsAiAttack  (aiutil)
  addr: 0013:4a72  len=296
  sig:  int16_t FIsAiAttack(FLEET *lpfl)
  params:
    FLEET *          lpfl           [BP+0x6]
  locals:
    int16_t          i              [BP-0x6]
    int16_t          ihul           [BP-0x4]

  stats: blocks=0  labels=0
*/
L_4a72:
    i = 0
    goto L_4b85

L_4a83:
    branch lpfl->rgcsh[i] <= 0 ? L_4b81 : L_4aa0

L_4aa0:
    ihul = rgshdef[i].hul.ihuldef
    branch ihul <= 5 ? L_4ac7 : L_4ab8

L_4ab8:
    branch ihul > 10 ? L_4ac7 : L_4ac1

L_4ac1:
    return 1

L_4ac7:
    branch ihul != 5 ? L_4b11 : L_4ad0

L_4ad0:
    branch HIWORD(rglpshdef[idPlayer][i].lPower) < 0x0 ? L_4b0b : L_4af5

L_4af5:
    branch HIWORD(rglpshdef[idPlayer][i].lPower) > 0x0 ? L_4b05 : L_4afa

L_4afa:
    branch LOWORD(rglpshdef[idPlayer][i].lPower) <= 0x0 ? L_4b0b : L_4b05

L_4b05:
    return 1

L_4b0b:

L_4b0e:
    return 0

L_4b11:
    branch ihul == 31 ? L_4b23 : L_4b1a

L_4b1a:
    branch ihul != 29 ? L_4b81 : L_4b23

L_4b23:
    branch WtMaxShdefStat(&rgshdef[i], 2) >= 500 ? L_4b81 : L_4b46

L_4b46:
    branch HIWORD(rglpshdef[idPlayer][i].lPower) < 0x0 ? L_4b81 : L_4b6b

L_4b6b:
    branch HIWORD(rglpshdef[idPlayer][i].lPower) > 0x0 ? L_4b7b : L_4b70

L_4b70:
    branch LOWORD(rglpshdef[idPlayer][i].lPower) <= 0x0 ? L_4b81 : L_4b7b

L_4b7b:
    return 1

L_4b81:
    i = (i + 1)

L_4b85:
    branch i < 16 ? L_4a83 : L_4b8e

L_4b8e:
    return 0

