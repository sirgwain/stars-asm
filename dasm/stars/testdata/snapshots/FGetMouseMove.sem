/*
FGetMouseMove  (utilgen)
  addr: 0009:4146  len=153
  sig:  int16_t FGetMouseMove(POINT16 *ppt)
  params:
    POINT16 *        ppt            [BP+0x6]
  locals:
    MSG              msg            [BP-0x14]

  stats: blocks=0  labels=0
*/
L_4146:

L_4152:
    branch PeekMessage(&msg, NULL, 0, 0, 1) != 0 ? L_417c : L_4176

L_4176:
    return TRUE

L_417c:
    goto L_41c3

L_4185:
    ppt->x = LOWORD(msg.lParam)
    ppt->y = hiword(msg.lParam)
    branch msg.message == WM_LBUTTONUP ? L_41ba : L_41b4

L_41b4:
    return TRUE

L_41ba:

L_41bd:
    return FALSE

L_41c3:
    branch msg.message == WM_MOUSEMOVE ? L_4185 : L_41cb

L_41cb:
    branch msg.message != WM_LBUTTONUP ? L_4152 : L_41d0

L_41d0:
    goto L_4185

