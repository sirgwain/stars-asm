/*
LogChangeThing  (log)
  addr: 000a:9908  len=238
  sig:  void LogChangeThing(THING *lpth, THING *pthNew)
  params:
    THING *          lpth           [BP+0x6]
    THING *          pthNew         [BP+0xa]
  locals:
    LOGXFER          lxNew          [BP-0x1e]
    int16_t          fChg           [BP-0x6]
    int16_t          i              [BP-0x4]

  stats: blocks=0  labels=0
*/
L_9908:
    fChg = 0
    branch gd.fGeneratingTurn != 0x0 ? L_99f0 : L_9929

L_9929:
    call memset(&lxNew, 0, 0x18) -> callresult(void *)
    lxNew.id = pthNew->idFull
    lxNew.grobj = grobjThing
    i = 0
    goto L_99a5

L_9952:
    lxNew.rgdItem[i] = sext16to32((pthNew->thp.rgwtMin[i] - lpth->thp.rgwtMin[i]))
    branch (pthNew->thp.rgwtMin[i] - lpth->thp.rgwtMin[i]) != 0 ? L_999c : L_9994

L_9994:
    branch signhiword((pthNew->thp.rgwtMin[i] - lpth->thp.rgwtMin[i])) == 0x0 ? L_99a1 : L_999c

L_999c:
    fChg = 1

L_99a1:
    i = (i + 1)

L_99a5:
    branch i < 3 ? L_9952 : L_99ae

L_99ae:
    branch fChg == 0 ? L_99f0 : L_99b7

L_99b7:
    branch fValidLx == 0 ? L_99da : L_99c1

L_99c1:
    call LogMakeValidXfer(&lx, &lxNew) -> callresult(void)
    fValidLx = 0
    goto L_99f0

L_99da:
    lx = lxNew
    fValidLx = 1

L_99f0:
    return
