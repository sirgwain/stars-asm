<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CFG graph</title>
  <script src="/cytoscape.min.js"></script>
  <script src="/dagre.min.js"></script>
  <script src="/cytoscape-dagre.js"></script>
  <style>
    html, body, #app {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: #17191d;
      color: #e8edf2;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    #app {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(520px, 34vw, 720px);
      grid-template-rows: 42px minmax(0, 1fr);
    }
    header {
      grid-column: 1 / 3;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 14px;
      border-bottom: 1px solid #2a3038;
      background: #20242a;
      user-select: none;
    }
    .title {
      font-size: 13px;
      font-weight: 650;
      color: #f6f8fb;
    }
    .meta {
      color: #9aa7b4;
      font-size: 12px;
      margin-right: auto;
    }
    button {
      height: 26px;
      border: 1px solid #3b4653;
      background: #27313b;
      color: #edf3f8;
      border-radius: 4px;
      padding: 0 9px;
      font: inherit;
      font-size: 12px;
    }
    button:hover {
      background: #33404d;
    }
    #cy {
      min-width: 0;
      min-height: 0;
      position: relative;
      background: #0f1217;
      overflow: hidden;
    }
    .cy-overlay {
      position: absolute;
      inset: 0;
      z-index: 4;
      pointer-events: none;
      overflow: hidden;
    }
    .scc-box {
      position: absolute;
      box-sizing: border-box;
      z-index: 1;
      pointer-events: none;
      border: 2px dashed rgba(94, 234, 212, 0.48);
      border-radius: 10px;
      background: rgba(45, 212, 191, 0.035);
      box-shadow: inset 0 0 24px rgba(45, 212, 191, 0.035);
    }
    .scc-box-label {
      position: absolute;
      left: 10px;
      top: 8px;
      padding: 2px 6px;
      border: 1px solid rgba(94, 234, 212, 0.34);
      border-radius: 4px;
      background: #0f1217;
      color: #5eead4;
      font: 10px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: 0;
      white-space: nowrap;
    }
    .graph-node {
      position: absolute;
      box-sizing: border-box;
      z-index: 2;
      overflow: hidden;
      border: 1px solid #344151;
      border-radius: 6px;
      background: #151a21;
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.28);
      color: #f4f7fb;
      pointer-events: auto;
      transform-origin: center center;
    }
    .graph-node.selected {
      border-color: #5eead4;
      box-shadow: 0 0 0 2px rgba(94, 234, 212, 0.34), 0 14px 30px rgba(0, 0, 0, 0.38);
    }
    .graph-node-title {
      height: 27px;
      box-sizing: border-box;
      padding: 6px 10px 4px;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      border-bottom: 1px solid #293241;
      background: #1d2430;
      color: #dbeafe;
      font: 10px/1.3 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
    .graph-node-asm {
      box-sizing: border-box;
      height: calc(100% - 27px);
      padding: 7px 10px;
      overflow: hidden;
      background: #11151c;
      font: 9.5px/1.28 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      white-space: pre;
    }
    .graph-node-asm span,
    .side-block-asm span {
      font: inherit;
    }
    aside {
      min-width: 0;
      min-height: 0;
      display: flex;
      flex-direction: column;
      border-left: 1px solid #2a3038;
      background: #17191d;
    }
    #side-title {
      padding: 12px 14px 10px;
      border-bottom: 1px solid #2a3038;
      font-size: 12px;
      font-weight: 650;
      color: #f4f7fa;
    }
    #blocks {
      flex: 1;
      padding: 10px;
      overflow: auto;
      background: #11151c;
    }
    .side-block {
      margin: 0 0 10px;
      overflow: hidden;
      border: 1px solid #2e3947;
      border-radius: 6px;
      background: #151a21;
    }
    .side-block.selected {
      border-color: #5eead4;
      box-shadow: 0 0 0 2px rgba(94, 234, 212, 0.22);
    }
    .side-block-title {
      padding: 7px 9px 6px;
      border-bottom: 1px solid #293241;
      background: #1d2430;
      color: #dbeafe;
      font: 11px/1.35 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
    .side-block-asm {
      margin: 0;
      padding: 8px 9px 10px;
      overflow: auto;
      white-space: pre;
      color: #f4f7fb;
      font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
  </style>
</head>
<body>
  <div id="app">
    <header>
      <div class="title" id="fn"></div>
      <div class="meta" id="stats"></div>
      <button id="fit">Fit</button>
      <button id="hierarchy">Hierarchy</button>
      <button id="cose">Cose</button>
    </header>
    <div id="cy"></div>
    <aside>
      <div id="side-title">Blocks</div>
      <div id="blocks"></div>
    </aside>
  </div>
  <script>
    if (window.cytoscapeDagre) {
      cytoscape.use(window.cytoscapeDagre);
    }
    const graphData = {{ .GraphData }};
    const nodeSize = (node) => {
      const lines = node.instructions || [];
      const maxLen = Math.max(node.title.length, ...lines.map((line) => line.length));
      return {
        width: Math.max(178, Math.min(600, maxLen * 5.75 + 32)),
        height: Math.max(50, 44 + lines.length * 12.9)
      };
    };
    const hierarchyLayout = () => ({
      name: "dagre",
      rankDir: "TB",
      rankSep: 82,
      nodeSep: 52,
      edgeSep: 14,
      padding: 64,
      ranker: "network-simplex",
      animate: false
    });
    const elements = [
      ...graphData.nodes.map((node) => {
        const size = nodeSize(node);
        return {
          group: "nodes",
          data: {
            id: node.id,
            shortLabel: node.label,
            title: node.title,
            asm: (node.instructions || []).join("\n"),
            asmHtml: node.asmHtml || "",
            scc: node.scc,
            nodeWidth: size.width,
            nodeHeight: size.height
          }
        };
      }),
      ...graphData.edges.map((edge) => ({
        group: "edges",
        data: {
          id: edge.id,
          source: edge.source,
          target: edge.target,
          kind: edge.kind || ""
        }
      }))
    ];
    const cy = cytoscape({
      container: document.getElementById("cy"),
      elements,
      wheelSensitivity: 0.18,
      style: [
        {
          selector: "node",
          style: {
            "shape": "round-rectangle",
            "width": "data(nodeWidth)",
            "height": "data(nodeHeight)",
            "background-color": "#151a21",
            "border-color": "#344151",
            "border-width": 1,
            "label": ""
          }
        },
        {
          selector: "node:selected",
          style: {
            "border-color": "#5eead4",
            "border-width": 2,
            "background-color": "#18202a"
          }
        },
        {
          selector: "edge",
          style: {
            "width": 1.35,
            "line-color": "#53657a",
            "target-arrow-color": "#53657a",
            "target-arrow-shape": "triangle",
            "curve-style": "bezier",
            "arrow-scale": 0.8
          }
        },
        {
          selector: "edge[kind = 'fallback']",
          style: {
            "width": 1.65,
            "line-style": "dashed",
            "line-dash-pattern": [10, 8]
          }
        }
      ],
      layout: hierarchyLayout()
    });
    const blocksPane = document.getElementById("blocks");
    const sideBlocks = new Map();
    const overlay = document.createElement("div");
    overlay.className = "cy-overlay";
    document.getElementById("cy").appendChild(overlay);
    const overlayNodes = new Map();
    const sccBoxes = [];
    (graphData.sccs || []).forEach((nodeIDs, index) => {
      if (!nodeIDs || nodeIDs.length < 2) return;
      const el = document.createElement("div");
      el.className = "scc-box";
      const label = document.createElement("div");
      label.className = "scc-box-label";
      label.textContent = "SCC " + (index + 1);
      el.appendChild(label);
      overlay.appendChild(el);
      sccBoxes.push({ nodeIDs, el });
    });
    const syncOverlayNode = (node, el) => {
      const pos = node.renderedPosition();
      const zoom = cy.zoom();
      el.style.width = node.width() + "px";
      el.style.height = node.height() + "px";
      el.style.left = pos.x + "px";
      el.style.top = pos.y + "px";
      el.style.transform = "translate(-50%, -50%) scale(" + zoom + ")";
      el.classList.toggle("selected", node.selected());
    };
    const syncSCCBox = (group) => {
      let minX = Infinity;
      let minY = Infinity;
      let maxX = -Infinity;
      let maxY = -Infinity;
      const zoom = cy.zoom();
      group.nodeIDs.forEach((id) => {
        const node = cy.getElementById(id);
        if (node.length === 0 || !node.visible()) return;
        const pos = node.renderedPosition();
        const halfW = (node.width() * zoom) / 2;
        const halfH = (node.height() * zoom) / 2;
        minX = Math.min(minX, pos.x - halfW);
        minY = Math.min(minY, pos.y - halfH);
        maxX = Math.max(maxX, pos.x + halfW);
        maxY = Math.max(maxY, pos.y + halfH);
      });
      if (!Number.isFinite(minX)) {
        group.el.style.display = "none";
        return;
      }
      const pad = Math.max(18, 28 * zoom);
      group.el.style.display = "block";
      group.el.style.left = (minX - pad) + "px";
      group.el.style.top = (minY - pad) + "px";
      group.el.style.width = (maxX - minX + pad * 2) + "px";
      group.el.style.height = (maxY - minY + pad * 2) + "px";
    };
    const syncOverlay = () => {
      cy.nodes().forEach((node) => {
        const el = overlayNodes.get(node.id());
        if (el) syncOverlayNode(node, el);
      });
      sccBoxes.forEach(syncSCCBox);
    };
    cy.nodes().forEach((node) => {
      const el = document.createElement("div");
      el.className = "graph-node";
      const nodeTitle = document.createElement("div");
      nodeTitle.className = "graph-node-title";
      nodeTitle.textContent = node.data("title");
      const nodeAsm = document.createElement("div");
      nodeAsm.className = "graph-node-asm";
      nodeAsm.innerHTML = node.data("asmHtml");
      el.appendChild(nodeTitle);
      el.appendChild(nodeAsm);
      el.addEventListener("click", (event) => {
        event.stopPropagation();
        cy.nodes().unselect();
        node.select();
        showNode(node);
      });
      overlay.appendChild(el);
      overlayNodes.set(node.id(), el);
    });
    graphData.nodes.forEach((block) => {
      const el = document.createElement("section");
      el.className = "side-block";
      el.dataset.nodeId = block.id;
      const blockTitle = document.createElement("div");
      blockTitle.className = "side-block-title";
      blockTitle.textContent = block.title;
      const blockAsm = document.createElement("pre");
      blockAsm.className = "side-block-asm";
      blockAsm.innerHTML = block.asmHtml || "";
      el.appendChild(blockTitle);
      el.appendChild(blockAsm);
      el.addEventListener("click", () => {
        const node = cy.getElementById(block.id);
        if (node.length > 0) {
          cy.nodes().unselect();
          node.select();
          showNode(node);
          cy.center(node);
        }
      });
      blocksPane.appendChild(el);
      sideBlocks.set(block.id, el);
    });
    const showNode = (node, scrollSide = true) => {
      sideBlocks.forEach((el, id) => {
        el.classList.toggle("selected", id === node.id());
      });
      if (scrollSide) {
        const selected = sideBlocks.get(node.id());
        if (selected) {
          selected.scrollIntoView({ block: "nearest" });
        }
      }
      syncOverlay();
    };
    document.getElementById("fn").textContent = graphData.function;
    document.getElementById("stats").textContent = graphData.nodes.length + " blocks  " + graphData.edges.length + " edges  " + graphData.sccs.length + " SCCs";
    cy.on("tap", "node", (event) => showNode(event.target));
    cy.on("pan zoom position render select unselect", syncOverlay);
    cy.on("layoutstop", syncOverlay);
    window.addEventListener("resize", syncOverlay);
    cy.ready(() => {
      const first = cy.nodes()[0];
      if (first) {
        first.select();
        showNode(first);
      }
      cy.fit(undefined, 40);
      syncOverlay();
    });
    document.getElementById("fit").addEventListener("click", () => {
      cy.fit(undefined, 40);
      syncOverlay();
    });
    document.getElementById("hierarchy").addEventListener("click", () => cy.layout(hierarchyLayout()).run());
    document.getElementById("cose").addEventListener("click", () => cy.layout({ name: "cose", animate: false, idealEdgeLength: 105, nodeOverlap: 34, padding: 64 }).run());
  </script>
</body>
</html>
