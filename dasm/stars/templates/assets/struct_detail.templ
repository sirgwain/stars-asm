{{- define "struct.detail" -}}
{{- if .DefinitionOnly -}}
{{.Kind}} {{.TagName}} {
{{.Body -}}
}; /* size={{hex .Size}} */
{{- else if .TypedefName -}}
typedef {{.Kind}} {{.TagName}} {
{{.Body -}}
} {{.TypedefName}}; /* size={{hex .Size}} */
{{- else -}}
{{.Kind}} {{.TagName}} {
{{.Body -}}
}; /* size={{hex .Size}} */
{{- end }}
{{- end -}}
{{ template "struct.detail" . }}
